# 复制此文件为 .env 后填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不要把真实密码提交进仓库

# ── 数据库连接 ──────────────────────────────────────────────
# 格式：postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# 密码含特殊字符（@ : / ? # 等）需要 URL 编码
# PostgreSQL 连接字符串
# 格式说明：
#   postgresql://  协议，固定写法
#   postgres       数据库用户名（安装时设置的）
#   :123456        密码（安装时设置的）
#   @localhost     数据库主机地址（本机就是 localhost）
#   :5432          PostgreSQL 默认端口
#   /nest_demo     数据库名（提前用 CREATE DATABASE 创建好）
#   ?schema=public 使用 public schema（PostgreSQL 的默认 schema）
DATABASE_URL="postgresql://user:password@localhost:5432/nest_demo?schema=public"

# ── Prisma 引擎下载镜像 ──────────────────────────────────────
PRISMA_ENGINES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"

# ── Ollama 配置 ──────────────────────────────────────────────
OLLAMA_HOST = "http://127.0.0.1:11434"
OLLAMA_CHAT_MODEL = "qwen3.5:4b"
OLLAMA_EMBED_MODEL = "mxbai-embed-large:latest"
OLLAMA_TEMPERATURE = "0.2"