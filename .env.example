# 复制此文件为 .env 后填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不要把真实密码提交进仓库

# ── 数据库连接 ──────────────────────────────────────────────
# 格式：postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# 密码含特殊字符（@ : / ? # 等）需要 URL 编码
DATABASE_URL="postgresql://user:password@localhost:5432/nest_demo?schema=public"

# ── Prisma 引擎下载镜像 ──────────────────────────────────────
# 本机解析不了官方 CDN binaries.prisma.sh（getaddrinfo ENOTFOUND），
# 不设这个，prisma generate / migrate 下载引擎时会失败
PRISMA_ENGINES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"
